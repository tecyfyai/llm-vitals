{
  "name": "llm-vitals-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/llm-vitals",
    "packages/vscode"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run lint && npm run build && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
